#!/usr/bin/env bash
#MISE description="Run BATS tests"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" default="" var=#true help="Test files, directories, or BATS arguments"
#USAGE example "mise run test" header="Run all tests in parallel across files"
#USAGE example "mise run test test/wake.bats" header="Run a specific test file"
#USAGE example "mise run test --filter 'session name'" header="Filter tests by name"
#USAGE example "mise run test --jobs 1" header="Run serially for debugging"
set -euo pipefail

export BATS_DEFAULT_TEST_TARGET="$MISE_CONFIG_ROOT/test"
export BATS_NUMBER_OF_PARALLEL_JOBS="${BATS_NUMBER_OF_PARALLEL_JOBS:-4}"
export BATS_PARALLEL_BINARY_NAME="${BATS_PARALLEL_BINARY_NAME:-rush}"
export BATS_NO_PARALLELIZE_WITHIN_FILE="${BATS_NO_PARALLELIZE_WITHIN_FILE:-true}"

exec bats --print-output-on-failure "$@"
