#!/usr/bin/env bash
#MISE description="Lint and format-check Python code with Ruff"
set -euo pipefail

check_targets=(
  .mise/tasks/query
  .mise/tasks/wait-any
  lib
  test
)

format_targets=(
  .mise/tasks/query
  .mise/tasks/wait-any
  lib
  test
)

ruff check ${check_targets[@]+"${check_targets[@]}"}
ruff format --check ${format_targets[@]+"${format_targets[@]}"}
