#!/usr/bin/env bash
#MISE description="Create a new session with optional system prompt and injected context"
#USAGE arg "[name]" default="" help="Session name (human-readable label, also used for lookup)"
#USAGE flag "--cwd <cwd>" default="" help="Working directory for the session (default: current directory)"
#USAGE flag "--system-prompt <prompt>" default="" help="System prompt content to bake into the session"
#USAGE flag "--system-prompt-file <file>" default="" help="File containing system prompt content to bake into the session"
#USAGE flag "--context <context>" default="" help="Initial context message to inject"
#USAGE flag "--context-file <context_file>" default="" help="File containing context message"
#USAGE flag "--meta <meta>" var=#true default="" help="Metadata key=value pairs (repeatable, supports dotted paths e.g. agent.name=ikma)"
#USAGE flag "--harness <harness>" default="" help="Harness adapter to use (default: pi, or value of SESSIONS_DEFAULT_HARNESS)"
#USAGE example "sessions new review/pr-50 --cwd . --meta purpose=review" header="Create a named session"

set -euo pipefail

NAME="${usage_name:-}"
CWD="${usage_cwd:-}"
SYSTEM_PROMPT="${usage_system_prompt:-}"
SYSTEM_PROMPT_FILE="${usage_system_prompt_file:-}"
SYSTEM_PROMPT_PROVIDED=false
[ -n "$SYSTEM_PROMPT" ] && SYSTEM_PROMPT_PROVIDED=true
CONTEXT="${usage_context:-}"
CONTEXT_FILE="${usage_context_file:-}"
META_RAW="${usage_meta:-}"
HARNESS_FLAG="${usage_harness:-}"

# Default cwd to current directory
if [ -z "$CWD" ]; then
  CWD="."
fi

# Resolve cwd to absolute path
CWD_ABS=$(cd "$CWD" 2>/dev/null && pwd) || {
  echo "Error: --cwd directory not found: $CWD" >&2
  exit 1
}

# Resolve system prompt and context from files if provided. File flags mirror
# the existing --context-file behavior: when both inline and file forms are
# supplied, the file content wins.
if [ -n "$SYSTEM_PROMPT_FILE" ]; then
  SYSTEM_PROMPT_PROVIDED=true
  if [ ! -f "$SYSTEM_PROMPT_FILE" ]; then
    echo "Error: system prompt file not found: $SYSTEM_PROMPT_FILE" >&2
    exit 1
  fi
  SYSTEM_PROMPT=$(cat "$SYSTEM_PROMPT_FILE")
fi

if [ -n "$CONTEXT_FILE" ]; then
  if [ ! -f "$CONTEXT_FILE" ]; then
    echo "Error: context file not found: $CONTEXT_FILE" >&2
    exit 1
  fi
  CONTEXT=$(cat "$CONTEXT_FILE")
fi

command -v jq >/dev/null 2>&1 || { echo "Error: jq is required" >&2; exit 1; }
command -v uuidgen >/dev/null 2>&1 || { echo "Error: uuidgen is required" >&2; exit 1; }

# shellcheck source=/dev/null
source "$MISE_CONFIG_ROOT/lib/harness/dispatch.sh"

# Resolve the harness for this new session. No session file yet, so only
# rule 1 (flag), rule 4 (env), and rule 5 (default) can apply.
HARNESS_NAME=$(harness_resolve --flag "$HARNESS_FLAG") || exit 1

# shellcheck source=/dev/null
source "$MISE_CONFIG_ROOT/lib/harness/$HARNESS_NAME.sh"

# --- Generate session ---

SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
NOW_ISO=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")
SESSION_FILE=$(harness_call "$HARNESS_NAME" session_file_path "$CWD_ABS" "$SESSION_ID" "$NOW_ISO")

# --- Build meta object from --meta flags ---
#
# Two formats supported:
#   --meta "agent.name=ikma"                          (dotted key=value)
#   --meta '{agent: {name: $ENV.GIT_AUTHOR_NAME}}'    (jq expression)
#
# Detected by first character: { = jq expression, otherwise dotted path.
# Multiple --meta flags are merged left to right.

META_JSON="{}"
if [ -n "$META_RAW" ]; then
  META_ENTRIES=$(printf '%s' "$META_RAW" | xargs printf '%s\n') || {
    META_ENTRIES_RC=$?
    echo "Error: failed to parse --meta arguments" >&2
    exit "$META_ENTRIES_RC"
  }

  if [ -n "$META_ENTRIES" ]; then
    while IFS= read -r entry; do
      [ -z "$entry" ] && continue
      if [[ "$entry" == "{"* ]]; then
        # jq expression — evaluate and merge
        FRAGMENT=$(jq -nc "$entry" 2>&1) || {
          echo "Error: invalid jq expression in --meta: $entry" >&2
          echo "  jq said: $FRAGMENT" >&2
          exit 1
        }
        META_JSON=$(echo "$META_JSON" "$FRAGMENT" | jq -s '.[0] * .[1]')
      elif [[ "$entry" == *"="* ]]; then
        # dotted key=value
        KEY="${entry%%=*}"
        VALUE="${entry#*=}"
        META_JSON=$(echo "$META_JSON" | jq --arg v "$VALUE" "setpath(\"$KEY\" | split(\".\"); \$v)")
      else
        echo "Error: invalid --meta format '$entry'" >&2
        echo "  Expected key=value (e.g., agent.name=ikma) or jq expression (e.g., '{purpose: \"test\"}')" >&2
        exit 1
      fi
    done <<< "$META_ENTRIES"
  fi
fi

# --- Session header ---

harness_call "$HARNESS_NAME" header_entry "$SESSION_ID" "$NOW_ISO" "$CWD_ABS" "$NAME" "$META_JSON" > "$SESSION_FILE"

# Harness declaration entry — records the active harness. Subsequent
# readers (wake, run, read) use `harness_resolve` over this file to
# pick the right adapter.
HARNESS_ENTRY_ID=$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-8)
harness_entry "$HARNESS_ENTRY_ID" "$SESSION_ID" "$NOW_ISO" "$HARNESS_NAME" >> "$SESSION_FILE"

LAST_ENTRY_ID="$HARNESS_ENTRY_ID"

# Harness-specific seed entries. Some harnesses refuse to launch from a
# file that holds no native message entry of their own; this is where
# an adapter puts whatever it needs to make the session launchable.
harness_call "$HARNESS_NAME" seed_entries "$SESSION_ID" "$NOW_ISO" "$CWD_ABS" >> "$SESSION_FILE"

# Bake the system prompt into the session if provided. `sessions wake` does not
# accept prompt flags; wake/run resolve this entry from the session file.
if [ "$SYSTEM_PROMPT_PROVIDED" = "true" ]; then
  PROMPT_ENTRY_ID=$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-8)
  system_prompt_entry "$PROMPT_ENTRY_ID" "$LAST_ENTRY_ID" "$NOW_ISO" "$SYSTEM_PROMPT" >> "$SESSION_FILE"
  LAST_ENTRY_ID="$PROMPT_ENTRY_ID"
fi

# Inject context as a user message if provided
if [ -n "$CONTEXT" ]; then
  MSG_ID=$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-8)
  # Built before the append, not piped into it: the adapter may read the
  # session file to build the entry (claude needs the session id and cwd
  # from the header), and reading a file inside its own append is both
  # fragile and a shellcheck SC2094 violation.
  CONTEXT_ENTRY=$(harness_call "$HARNESS_NAME" user_message_entry "$MSG_ID" "$LAST_ENTRY_ID" "$NOW_ISO" "$CONTEXT" "$SESSION_FILE")
  printf '%s\n' "$CONTEXT_ENTRY" >> "$SESSION_FILE"
fi

# --- Output ---

echo "$SESSION_ID"
if [ -n "$NAME" ]; then
  echo "Created session '$NAME'" >&2
else
  echo "Created session ${SESSION_ID:0:8}" >&2
fi
echo "cwd: $CWD_ABS" >&2
if [ "$SYSTEM_PROMPT_PROVIDED" = "true" ]; then
  echo "System prompt: $(echo "$SYSTEM_PROMPT" | head -1 | cut -c1-80)..." >&2
fi
if [ -n "$CONTEXT" ]; then
  echo "Context: $(echo "$CONTEXT" | head -1 | cut -c1-80)..." >&2
fi
