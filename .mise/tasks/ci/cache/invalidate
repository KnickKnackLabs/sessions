#!/usr/bin/env -S uv run --script
#MISE description="Preview or delete exact GitHub Actions mise cache IDs"
#MISE dir="{{config_root}}"
#USAGE arg "<cache_ids>" var=#true help="Exact cache IDs from ci:cache:status"
#USAGE flag "--yes" default=#false help="Delete the selected cache IDs and verify their absence"
#USAGE example "mise run ci:cache:invalidate 7336710345" header="Preview one exact cache deletion"
#USAGE example "mise run ci:cache:invalidate 7336710345 --yes" header="Delete and verify one exact cache"
# /// script
# requires-python = ">=3.10"
# ///

import os
import shlex
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.environ["MISE_CONFIG_ROOT"], "lib"))

from ci_cache import CacheError, invalidate

cache_ids = shlex.split(os.environ.get("usage_cache_ids", ""))
confirmed = os.environ.get("usage_yes", "false") == "true"

try:
    invalidate(Path(os.environ["MISE_CONFIG_ROOT"]), cache_ids, confirmed=confirmed)
except CacheError as error:
    print(f"Error: {error}", file=sys.stderr)
    raise SystemExit(1) from error
